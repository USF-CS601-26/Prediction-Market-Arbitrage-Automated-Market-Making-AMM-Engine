# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Which Kalshi environment to use: "demo" or "prod".
# NOTE: demo and prod are separate accounts with separate keypairs. Using the
# wrong one returns HTTP 401 with details "NOT_FOUND" (meaning the key id does
# not exist in that environment), which is NOT a signature problem.
# Also note the demo environment has no quoted liquidity — every demo market
# returns an empty book and never emits deltas.
KALSHI_ENV=prod

# Production credentials (kalshi.com -> Account -> Profile -> API Keys).
# The private key is downloaded once at creation and cannot be retrieved again.
KALSHI_PROD_API_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_PROD_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_prod_private_key.pem

# Demo credentials (demo.kalshi.co), optional.
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=

# Market to stream.
KALSHI_MARKET_TICKER=KXLEADERSOUT-27JAN01-BNETISR
